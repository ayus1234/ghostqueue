# ==============================================================================
# GhostQueue Environment Configuration Template
# Copy this file to .env or set variables in your cloud deployment environment.
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS.
# ==============================================================================

# Backend API Configuration
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# AWS Cloud Settings (Optional / Cloud Deployment)
# When deploying to AWS, these can be set via environment or IAM execution roles.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Privacy Settings
TEMP_STORAGE_DIR=temp_uploads
