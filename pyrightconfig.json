{
  "include": [
    "backend"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    ".git"
  ],
  "extraPaths": [
    "backend",
    "C:/Python313/Lib/site-packages"
  ],
  "typeCheckingMode": "basic",
